# All values are optional — every one of them has a working default.
# Leave MONGODB_URI unset to boot an in-process MongoDB automatically.
# MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=usage_platform
PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:3000
PROVISIONING_MS=10000
SWEEPER_INTERVAL_MS=1000
# Leaky bucket (GCRA). RATE_LIMIT_PER_MINUTE is the sustained rate;
# RATE_LIMIT_BURST is the bucket capacity and defaults to the same number.
# Lower the burst to smooth harder — RATE_LIMIT_BURST=1 admits one request per
# emission interval (600ms at 100/min) and permits no burst at all.
RATE_LIMIT_PER_MINUTE=100
# RATE_LIMIT_BURST=100
RATE_LIMIT_STORE=mongo
DEMO_ACCOUNT_KEY=demo-account-key
LOG_LEVEL=info
